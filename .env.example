PORT=3000
APP_URL=http://localhost:3000
DATABASE_URL=postgresql://jr:change-me@localhost:5432/jr
NODE_ENV=development
PAYMENT_MODE=disabled
# disabled | test | production. Production additionally requires explicit activation below.
ALLOW_LIVE_PAYMENTS=false
MP_ACCESS_TOKEN=
MP_WEBHOOK_SECRET=
MP_COLLECTOR_ID=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
GOOGLE_CALENDAR_ID=
CALENDAR_MODE=internal
CALENDAR_REQUIRED=false
EMAIL_API_KEY=
EMAIL_FROM=
PRIVACY_CONTACT=
WORKER_INTERVAL_MS=15000

# Gere uma chave aleatória de pelo menos 32 caracteres para os links de e-mail.
EMAIL_LOOKUP_SECRET=
POSTGRES_PASSWORD=

# Avisos internos à equipe. Destinatários editáveis no painel.
WHATSAPP_API_URL=
WHATSAPP_INSTANCE=
WHATSAPP_API_KEY=
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
# E-mails para clientes só são enviados quando habilitados explicitamente.
CUSTOMER_EMAIL_ENABLED=false

# Private clinical storage. Generate a 32-byte random key on the server; never commit it.
ANAMNESIS_ENCRYPTION_KEY=
# Set the retention agreed by the controller BEFORE activating the clinical catalogue.
ANAMNESIS_RETENTION_DAYS=
